<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Punjab National College - Peshawar Chapter Results</title>
  <meta name="description" content="Punjab National College Peshawar Chapter official online examination result portal.">
  <meta name="robots" content="index,follow">
  <link rel="canonical" href="https://YOUR-WEBSITE-URL/">
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f3f6fb;
      margin: 0;
      color: #17324d;
    }
    header {
      background: #064b36;
      color: white;
      text-align: center;
      padding: 25px 12px;
    }
    main {
      max-width: 520px;
      margin: 35px auto;
      padding: 24px;
      background: white;
      border-radius: 12px;
      box-shadow: 0 4px 18px #0001;
    }
    input, button {
      box-sizing: border-box;
      width: 100%;
      padding: 13px;
      margin-top: 12px;
      border-radius: 7px;
      font-size: 16px;
    }
    input { border: 1px solid #ccd5df; }
    button {
      background: #08764d;
      color: white;
      border: 0;
      cursor: pointer;
    }
    footer {
      text-align: center;
      color: #667;
      padding: 20px;
      font-size: 13px;
    }
  </style>
</head>
<body>
  <header>
    <h1>Punjab National College</h1>
    <p>Peshawar Chapter — Online Result Portal</p>
  </header>

  <main>
    <h2>Check Your Examination Result</h2>
    <p>Apna roll number enter karein.</p>
    <form action="/result" method="get">
      <label for="roll">Student Roll Number</label>
      <input id="roll" name="roll" required
             maxlength="30" placeholder="Enter your roll number">
      <button type="submit">Check Result</button>
    </form>
    <p>Result na milne par college administration se rabta karein.</p>
  </main>

  <footer>
    Punjab National College — Peshawar Chapter
  </footer>
</body>
</html>